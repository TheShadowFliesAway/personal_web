# 本地体验专用；云端部署必须设为 false。生产环境始终拒绝演示模式。
DEMO_MODE=true
# 云端运行时必须填写这四项；密钥只放环境变量，不提交到 Git。
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=
ADMIN_PASSWORD_HASH=
SESSION_SECRET=
# R2 图片存储，可在文字功能上线后再配置。
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
# 应用内上传总量限额（默认 1 GiB），不是云平台账单硬上限。
IMAGE_STORAGE_LIMIT_MB=1024

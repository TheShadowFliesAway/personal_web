# 本地体验专用；云端部署必须设为 false。生产环境始终拒绝演示模式。
DEMO_MODE=true
# 云端运行时必须填写这四项；密钥只放环境变量，不提交到 Git。
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=
ADMIN_PASSWORD_HASH=
SESSION_SECRET=
# R2 图片存储，可在文字功能上线后再配置。
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
# 应用内上传总量限额（默认 1 GiB），不是云平台账单硬上限。
IMAGE_STORAGE_LIMIT_MB=1024
# 可选：ChatGPT 远程 MCP；只在正式环境启用。详情见 DEPLOY.md。
MCP_ENABLED=false
# 网站的固定 HTTPS origin，不带路径或结尾斜杠。
MCP_ORIGIN=
MCP_CLIENT_ID=papertrail-chatgpt
# npm run mcp:setup 生成，与登录密码 / SESSION_SECRET 分开。
MCP_CLIENT_SECRET=
# 从 ChatGPT 配置界面复制完整 OAuth 回调地址，多个地址用英文逗号分隔。
MCP_REDIRECT_URIS=
